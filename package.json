{
  "name": "tailwindui-template",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "emulators": "firebase emulators:start --project demo-portal --import=./.emulator-data --export-on-exit=./.emulator-data",
    "seed": "FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099 tsx scripts/seed-emulator.ts",
    "test:rules": "firebase emulators:exec --project demo-portal --only firestore \"vitest run tests/rules\"",
    "test:rules:watch": "FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 vitest tests/rules"
  },
  "browserslist": "defaults, not ie <= 11",
  "dependencies": {
    "@headlessui/react": "^2.0.1",
    "@mapbox/rehype-prism": "^0.9.0",
    "@mdx-js/loader": "^3.0.0",
    "@mdx-js/react": "^3.0.0",
    "@next/mdx": "^14.0.4",
    "@tailwindcss/typography": "^0.5.4",
    "@types/node": "^20.10.8",
    "@types/react": "^18.2.47",
    "@types/react-dom": "^18.2.18",
    "@types/webpack-env": "^1.18.1",
    "autoprefixer": "^10.4.12",
    "cheerio": "^1.0.0-rc.12",
    "clsx": "^2.1.0",
    "fast-glob": "^3.2.11",
    "feed": "^4.2.2",
    "firebase": "^11.10.0",
    "firebase-admin": "^13.10.0",
    "next": "^14.0.4",
    "next-themes": "^0.2.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "remark-gfm": "^4.0.0",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "eslint": "^8.56.0",
    "eslint-config-next": "^14.0.4",
    "firebase-tools": "^14.27.0",
    "prettier": "^3.1.1",
    "prettier-plugin-tailwindcss": "^0.5.11",
    "sharp": "0.33.1",
    "tsx": "^4.23.1",
    "vitest": "^3.2.7"
  }
}
