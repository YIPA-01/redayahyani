# Emulator-only settings, loaded by next dev. Contains no secrets.
# Production builds never read this file, so deployed code cannot
# inherit emulator pointers.
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=true
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-portal
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
